# Copy to .env and replace change-me before starting Compose.
# Keep .env local; this is the only configuration template.
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ocr_db
POSTGRES_PORT=5432
REDIS_PORT=63797
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Browser-facing address; rebuild frontend after changing it.
NEXT_PUBLIC_API_URL=http://localhost:8000
OCR_LANGUAGE=korean
OCR_DETECTION_MODEL=PP-OCRv5_mobile_det
OCR_CPU_THREADS=4
OCR_WARMUP=1
# Warmup counts as one task; keep 5 until memory stability has been measured.
OCR_WORKER_MAX_TASKS_PER_CHILD=5
OCR_DETECTION_SIZE=2048
OCR_UPSCALE_TARGET=1600
OCR_REFINE_MAX_CROPS=64
# OCR_STORAGE_HOST_DIR=./storage
# Absolute original storage path, if starting Compose outside the project root:
# OCR_STORAGE_LEGACY_ROOT=/absolute/path/to/project/storage

# Detector pixel budget; recognition crops retain their original resolution.
OCR_DETECTION_MAX_PIXELS=1000000
OCR_RECOGNITION_BATCH_SIZE=4
OCR_WORKER_MEMORY_LIMIT=7g
OCR_TASK_TIME_LIMIT=5400

# Leave the bucket empty to keep local storage. EC2 uses its attached IAM role.
OCR_S3_BUCKET=
AWS_REGION=
# Local S3 testing uses docker-compose.s3-local.yml and the existing ~/.aws files.
# AWS_PROFILE=default
# AWS_SHARED_CONFIG_DIR=/absolute/path/to/.aws

# EC2 deployment only; see docs/aws-deployment.md. Keep local defaults otherwise.
# FRONTEND_BIND_IP=0.0.0.0
# BACKEND_BIND_IP=0.0.0.0
# POSTGRES_BIND_IP=10.0.1.10
# REDIS_BIND_IP=10.0.1.10
# CORS_ORIGINS=http://your-web-host:3000
# NEXT_PUBLIC_API_URL=http://your-web-host:8000
# Worker host: connect to the web host's private IP and published ports.
# WORKER_DATABASE_URL=postgresql://admin:your-url-encoded-password@10.0.1.10:5432/ocr_db
# WORKER_REDIS_URL=redis://10.0.1.10:63797/0
