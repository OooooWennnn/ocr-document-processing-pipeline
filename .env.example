# Copy to .env and replace change-me. Never commit the real .env.
POSTGRES_PASSWORD=change-me
# Local PostgreSQL; replace the whole URL to use Supabase.
DATABASE_URL=postgresql://admin:${POSTGRES_PASSWORD}@db:5432/ocr_db

# Optional: leave the bucket empty to store files locally.
OCR_S3_BUCKET=
AWS_REGION=us-east-1
